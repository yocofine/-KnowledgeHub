# Generated secrets belong in edu/.env; never copy legacy encryption keys.
BIND_ADDRESS=127.0.0.1
APP_PORT=18080
FRONTEND_PORT=18081
DB_USER=weknora
DB_NAME=weknora
DB_PASSWORD=GENERATE_ME
REDIS_PASSWORD=GENERATE_ME
SYSTEM_AES_KEY=GENERATE_ME
SYSTEM_SIGNING_KEY=GENERATE_ME
JWT_SECRET=GENERATE_ME
# Keep the initial installation on loopback while creating new accounts.
# Disable public registration after all intended users have registered.
DISABLE_REGISTRATION=false
APP_EXTERNAL_URL=
FRONTEND_BASE_URL=
# Optional: replace each image with a verified copy in your private registry.
# Do not assume a public mirror has the same image and tag.
WEKNORA_UI_IMAGE=wechatopenai/weknora-ui:v0.8.2
WEKNORA_APP_IMAGE=wechatopenai/weknora-app:v0.8.2
WEKNORA_DOCREADER_IMAGE=wechatopenai/weknora-docreader:v0.8.2
WEKNORA_POSTGRES_IMAGE=paradedb/paradedb:v0.22.6-pg17
WEKNORA_REDIS_IMAGE=redis:7.0-alpine
